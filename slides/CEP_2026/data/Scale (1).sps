* Encoding: UTF-8.

DATASET ACTIVATE Dataset2.
COMPUTE SWLS= MEAN (SWLS1, SWLS2, SWLS3, SWLS4, SWLS5).
COMPUTE IHS= MEAN (IHS1, IHS2, IHS3, IHS4, IHS5, IHS6, IHS7, IHS8, IHS9).
COMPUTE SHS= MEAN (SHS1, SHS2, SHS3, SHS4).
COMPUTE NFR= MEAN (NFR1, NFR2, NFR3, NFR5, NFR6, NFR7, NFR8, NFR9, NFR10, NFR11).
COMPUTE PRSfascina= MEAN (PRS1, PRS2, PRS3).
COMPUTE PRSb.away= MEAN (PRS4, PRS5, PRS6).
COMPUTE PRScohe= MEAN (PRS7, PRS8, PRS9).
COMPUTE PRSscope= MEAN (PRS10, PRS11).
COMPUTE DASSdep= MEAN (DASS3, DASS5, DASS10, DASS13, DASS16, DASS17, DASS21).
COMPUTE DASSanx= MEAN (DASS2, DASS4, DASS7, DASS9, DASS15, DASS19, DASS20).
COMPUTE DASSstress= MEAN (DASS1, DASS6, DASS8, DASS11, DASS12, DASS14, DASS18).
COMPUTE VQALarido= MEAN (VQAL8, VQAL7, VQAL21, VQAL6, VQAL18, VQAL17, VQAL3, VQAL14).
COMPUTE VQALvivace= MEAN (VQAL2, VQAL4, VQAL16, VQAL24, VQAL12, VQAL15, VQAL13).
COMPUTE VQALcalmo= MEAN (VQAL19, VQAL23, VQAL9).
COMPUTE RSLEQcollabo= MEAN (RSLEQ1, RSLEQ6, RSLEQ11, RSLEQ16_REC, RSLEQ20_REC, RSLEQ21_REC).
COMPUTE RSLEQstud.relations= MEAN (RSLEQ2, RSLEQ7, RSLEQ12, RSLEQ17).
COMPUTE RSLEQsch.ressources= MEAN (RSLEQ3_REC, RSLEQ8, RSLEQ13, RSLEQ18_REC).
COMPUTE RSLEQdeci.making= MEAN (RSLEQ4, RSLEQ9_REC, RSLEQ14_REC).
COMPUTE RSLEQinstru.innovations= MEAN (RSLEQ5, RSLEQ15, RSLEQ19).
EXECUTE.
COMPUTE DASSTotal= MEAN (DASSdep, DASSanx, DASSstress).
execute.
COMPUTE RSLEQTotal= MEAN (RSLEQcollabo, RSLEQstud.relations, RSLEQsch.ressources, RSLEQdeci.making, RSLEQinstru.innovations).
execute.
Compute VQALaridoR= 7-VQALarido.
compute VQALtot = MEAN (VQALaridoR, VQALvivace, VQALcalmo).
execute.
compute PRStot = MEAN (PRSb.away, PRSfascina, PRScohe, PRSscope).
execute.

COMPUTE DASSdepDOP= MEAN (DASS3DOP, DASS5DOP, DASS10DOP, DASS13DOP, DASS16DOP, DASS17DOP, DASS21DOP).
COMPUTE DASSanxDOP= MEAN (DASS2DOP, DASS4DOP, DASS7DOP, DASS9DOP, DASS15DOP, DASS19DOP, DASS20DOP).
COMPUTE DASSstressDOP= MEAN (DASS1DOP, DASS6DOP, DASS8DOP, DASS11DOP, DASS12DOP, DASS14DOP, DASS18DOP).
execute.
******************************Alfa fattori*****************************

******************SWLS***********************

